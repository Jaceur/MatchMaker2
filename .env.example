# Copy to `.env` at the project ROOT and fill in. This ONE file feeds everything
# that runs locally — the API, the worker, and the scripts (rerun_pipeline.py,
# enrich_local.py, sic_data.py, the ch_* tools) — via env_loader.py.
# On Railway there is no .env: set these as service Variables instead.
#
# `.env` is gitignored. NEVER commit real values.
# Quoting: this is NOT TOML. A value containing " or ) or ; needs no quotes and
# no escaping — paste it raw after the "=".

# --- Database (Supabase; use the SESSION POOLER values, not the direct connection) ---
# Supabase dashboard -> Connect -> Session pooler.
DB_PASSWORD=your-supabase-db-password
SUPABASE_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_USER=postgres.<project-ref>
SUPABASE_DBNAME=postgres

# --- Companies House ---
# REST key: lead sourcing + director enrichment. Without it, sourcing 401s and
# director enrichment returns "No directors found".
CH_API_KEY=your-companies-house-rest-key
# STREAMING key: a SEPARATE CH application from the REST key above, so one leak
# can't burn both. Only used by the ch_stream.py listener.
CH_STREAM_KEY=your-companies-house-streaming-key

# --- API auth ---
# Signs the login JWTs. Set a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If blank or absent it falls back to DB_PASSWORD, which works but means one
# leaked value opens both the database and every user's session.
JWT_SECRET=
# Comma-separated allowed frontend origins (exact scheme+host, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# --- New-incorps live stream ---
# Shared secret CHStream sends as the X-Ingest-Key header when POSTing new
# incorporations to /new-incorps/ingest. Set the SAME value here and in CHStream.
# Empty = the ingest endpoint is disabled (503). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
NEW_INCORP_INGEST_KEY=

# --- New-incorps -> Google Sheet (ONE-WAY: the API only ever POSTs) ---
# Setup walkthrough: google_sheet/README.md
# The Apps Script web-app URL (ends in /exec). EMPTY = the sheet feed is off.
SHEET_WEBHOOK_URL=
# Shared secret checked by the Apps Script — must match SHARED_KEY at the top of
# google_sheet/Code.gs. A published web app is a public URL, so this is the only
# thing stopping strangers writing rows. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SHEET_WEBHOOK_KEY=
# 1 = send every incorporation (~2,000/day) to the "New Incorps" tab as well as
# the high-value ones. 0 = high-value only.
SHEET_SEND_ALL=1
# How long a row may wait before its batch is sent. Lower = fresher sheet, but
# more calls against Apps Script's daily runtime quota (90 min personal / 6 h
# Workspace). High-value barely waits — it's the first-to-contact race.
SHEET_FLUSH_SECONDS=15
SHEET_FLUSH_SECONDS_HIGH_VALUE=3

# --- High-value criteria ---
# Starting capital (£) a new incorporation must be strictly ABOVE to count as
# high value. 25000 until 2026-08-05, now 10000. Corporate ownership and a London
# Zone-1 postcode also qualify regardless of capital (those aren't tunable here).
HIGH_VALUE_CAPITAL_THRESHOLD=10000
